# ==============================================================================
# LiteLlmRTKSync — configuração completa por variável de ambiente
# ==============================================================================
# Copie para .env e preencha. O .env NUNCA é versionado; este arquivo de
# exemplo não carrega valor de segredo algum, porque um valor publicado em
# exemplo é, por definição, uma credencial pública.

# ------------------------------------------------------------------------------
# 1. Proxy LiteLLM
# ------------------------------------------------------------------------------
# Endereço do proxy. Dentro do compose é o nome do serviço.
LITELLM_URL=http://litellmrtk-router:4000

# Master key do proxy, usada para ler o estado administrativo. Obrigatória, e
# segredo: preencha no .env, nunca aqui.
LITELLM_MASTER_KEY=

# ------------------------------------------------------------------------------
# 2. Ciclo de inspeção
# ------------------------------------------------------------------------------
# Intervalo entre ciclos, em segundos.
SYNC_INTERVAL=300

# Antecedência com que uma chave virtual passa a ser reportada como "vencendo".
REFRESH_MARGIN=900

# Agendador interno (1=ligado, 0=desligado).
CRON_ENABLED=1
# CRON_INTERVAL=300        # herda SYNC_INTERVAL quando omitido

# ------------------------------------------------------------------------------
# 3. Teto da plataforma
# ------------------------------------------------------------------------------
# Nenhum time e nenhuma chave pode declarar limite acima destes valores. O
# LiteLLM aceita a configuração incoerente sem reclamar: na prática vale sempre
# o teto mais restritivo do caminho, então o número maior existe só no cadastro.
# Vazio significa "sem teto declarado" — relatado como escolha, não como erro.
PLATFORM_RPM_LIMIT=
PLATFORM_TPM_LIMIT=
PLATFORM_MAX_BUDGET=

# ------------------------------------------------------------------------------
# 4. Painel
# ------------------------------------------------------------------------------
ENABLE_WEB_DASHBOARD=1
WEB_HOST=0.0.0.0
# Porta interna 9090, igual nos três sincronizadores.
WEB_PORT=9090
DASHBOARD_USER=admin
# Sem senha de fábrica: defina a sua pela tela no primeiro acesso. O primeiro
# acesso usa a credencial de recuperação, gerada no primeiro boot e gravada com
# modo 0600 no diretório de dados.
DASHBOARD_PASSWORD=
# DASHBOARD_RECOVERY_HASH=

# ------------------------------------------------------------------------------
# 5. Validação de credenciais
# ------------------------------------------------------------------------------
# Pergunta a cada provedor se a chave declarada no modelo ainda é aceita, em vez
# de assumir que uma chave cadastrada funciona.
CREDENTIAL_CHECK_ENABLED=1
CREDENTIAL_CHECK_TIMEOUT=8

# ------------------------------------------------------------------------------
# 6. Armazenamento e log
# ------------------------------------------------------------------------------
# Base de tudo que este container escreve. Criado no startup.
DATA_DIR=/app/data
LOG_DIR=/app/data/logs
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
LOG_TO_STDOUT=1

# ------------------------------------------------------------------------------
# 7. Stack de teste (docker-compose.test.yml)
# ------------------------------------------------------------------------------
# Obrigatórias e sem valor padrão de propósito: o compose recusa subir sem elas.
POSTGRES_PASSWORD=
LITELLM_SALT_KEY=
